# Discord bot credentials
DISCORD_TOKEN=replace-with-your-discord-bot-token

# Bot command and logging configuration.
COMMAND_PREFIX=.
# Command modes available to all guilds. A mode set to false cannot be enabled
# by a guild administrator. At least one mode must be true.
SLASH_COMMANDS_ENABLED=true
PREFIX_COMMANDS_ENABLED=true
LOG_MAX_BYTES=8388608
LOG_BACKUP_COUNT=5
# Limits for expensive external work. Cooldowns use seconds; zero disables that
# command's cooldown. Keep playlist import concurrency at 1 unless capacity
# testing demonstrates the host can safely resolve multiple imports at once.
YTDLP_TIMEOUT_SECONDS=45
PLAY_COOLDOWN_SECONDS=0
SEARCH_COOLDOWN_SECONDS=1
PLAYLIST_IMPORT_CONCURRENCY_PER_GUILD=1
# Now-playing controls remain active for at least this long. For known-duration
# tracks, the timeout is the remaining duration plus the buffer below.
NOW_PLAYING_CONTROLS_MINIMUM_TIMEOUT_SECONDS=600
NOW_PLAYING_CONTROLS_TIMEOUT_BUFFER_SECONDS=60
# Signed YouTube stream URLs are cached in memory only. Refresh a cached URL
# before it reaches this many seconds from expiry.
STREAM_URL_CACHE_SAFETY_MARGIN_SECONDS=300
STREAM_URL_CACHE_MAX_ENTRIES=200
SAVED_PLAYLIST_RESOLUTION_CONCURRENCY=3
# Persistent personal playlists. Each user can create this many playlists and
# save this many tracks in total across all of their playlists.
MAX_PLAYLISTS_PER_USER=3
MAX_SONGS_PER_USER=50

# Automatically leave voice channels. Set either *_ENABLED value to false to disable
# that policy. Empty-channel delay of 0 disconnects at the next check.
AUTO_DISCONNECT_EMPTY_CHANNEL_ENABLED=true
AUTO_DISCONNECT_EMPTY_CHANNEL_MINUTES=0
AUTO_DISCONNECT_INACTIVITY_ENABLED=true
AUTO_DISCONNECT_INACTIVITY_MINUTES=10

# Cron expression for checking and installing the latest yt-dlp release.
# Default: daily at 04:00, using the container's time zone.
YTDLP_UPDATE_SCHEDULE="0 4 * * *"

# Persistent per-guild song play counts and ratings.
SONG_STATS_DATABASE_PATH=/app/data/song_stats.db

# Persistent personal playlists available in every server where the user runs the bot.
USER_PLAYLIST_DATABASE_PATH=/app/data/user_playlists.db

# Persistent per-guild overrides configured with .config or /config.
GUILD_CONFIG_DATABASE_PATH=/app/data/guild_config.db

# Spotify playlist support. Generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SPOTIFY_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
SPOTIFY_DATABASE_PATH=/app/data/spotify.db
PLAYLIST_MAX_TRACKS=20
PLAYLIST_DEFAULT_TRACKS=20
PLAYLIST_DEFAULT_SHUFFLE=false
# Two-letter country code used for Spotify metadata availability checks.
SPOTIFY_MARKET=US
# Register this exact URI in the Spotify Developer Dashboard. Spotify forbids
# localhost, but permits HTTP for an explicit loopback IP. Users copy the
# redirect URL from their browser into a Discord DM to authorize playlist access.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/spotify-callback